[user]
  signingkey = ~/.ssh/id_ed25519_sk_git-primary

[credential]
  credentialStore = keychain
#  Remove this for Xcode
# [url "ssh://git@github.com/"]
# 	insteadOf = https://github.com/

[gpg]
  format = ssh

[gpg "ssh"]
  program = ~/.local/bin/git-sign-yk
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[core]
  sshCommand = /opt/homebrew/bin/ssh
